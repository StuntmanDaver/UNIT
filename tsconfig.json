{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "app.config.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "constants/**/*.ts",
    "hooks/**/*.ts",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "services/**/*.ts",
    "types/**/*.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "android",
    "ios",
    ".expo",
    "dist",
    "build",
    "coverage",
    "node_modules",
    "supabase/functions"
  ]
}
